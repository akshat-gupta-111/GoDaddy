# Copy to .env and fill in. Never commit .env or put real values in this file.

# Backend
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional. If empty, a key is generated in instance/secret_key.
SECRET_KEY=

# Chatbot (Azure OpenAI)
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names as shown in Azure, which may differ from model names
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
