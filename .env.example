# Copy to .env and fill in. Never commit .env or put real values in this file.

# Backend
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional. If empty, a key is generated in instance/secret_key.
SECRET_KEY=

# Chatbot: Azure OpenAI chat (GPT-4o). The endpoint is the full request URL.
AZURE_OPENAI_ENDPOINT='https://<resource-name>.openai.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview'
AZURE_OPENAI_API_KEY=

# Chatbot: Azure OpenAI embeddings. The endpoint is the full request URL and may
# belong to a different resource from the chat model, with its own key.
AZURE_OPENAI_EMBEDDINGS_ENDPOINT='https://<resource-name>.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2023-05-15'
AZURE_OPENAI_EMBEDDINGS_API_KEY=
